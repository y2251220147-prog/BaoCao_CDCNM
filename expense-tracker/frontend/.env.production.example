# ── FRONTEND PRODUCTION CONFIG ───────────────────────────────────────────────
# Sao chép file này thành .env.production và điền URL backend thực tế
# cp .env.production.example .env.production

# Hướng A — Deploy lên Render:
# VITE_API_URL=https://expense-tracker-backend-xxxx.onrender.com/api

# Hướng B — Deploy lên VPS:
# VITE_API_URL=http://YOUR_SERVER_IP/api
# hoặc nếu có domain:
# VITE_API_URL=https://yourdomain.com/api

VITE_API_URL=https://your-backend-url.onrender.com/api
