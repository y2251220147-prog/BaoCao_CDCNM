# ── DATABASE CONFIG ───────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=expense_tracker
DB_USER=root
DB_PASSWORD=your_password_here

# ── PORTS ────────────────────────────────────────────
# Cổng expose cho MySQL (nếu chạy Docker)
MYSQL_LOCAL_PORT=3307
BACKEND_PORT=5000
FRONTEND_PORT=3001

# ── BACKEND CONFIG ───────────────────────────────────
NODE_ENV=development
# URL của Frontend để CORS cho phép truy cập
CLIENT_URL=http://localhost:3001

# ── FRONTEND CONFIG ──────────────────────────────────
# URL của Backend API cho Frontend gọi tới
VITE_API_URL=http://localhost:5000/api
